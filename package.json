{
  "name": "nutget",
  "version": "0.1.0",
  "description": "Standalone Composer-like package manager for Squirrel and .nut projects",
  "keywords": [
    "nutget",
    "squirrel",
    "nut",
    "cli",
    "package-manager",
    "autoload",
    "framework"
  ],
  "homepage": "https://github.com/SzymonKostrubiec/Acorn-FileManager",
  "bugs": {
    "url": "https://github.com/SzymonKostrubiec/Acorn-FileManager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SzymonKostrubiec/Acorn-FileManager.git"
  },
  "license": "MIT",
  "author": "Szymon Kostrubiec",
  "type": "module",
  "bin": {
    "nutget": "dist/nutget.cjs"
  },
  "files": [
    "dist",
    "README.MD",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "node ./bin/nutget.js help",
    "pack:preview": "npm pack --dry-run",
    "build:bundle": "node ./scripts/build-bundle.mjs",
    "build:binary": "node ./scripts/build-sea.mjs",
    "build:release": "npm run build:bundle && npm run build:binary",
    "prepack": "npm run build:bundle",
    "prepublishOnly": "npm run smoke && npm run pack:preview"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
